# VCS
.git
.gitignore

# Docker
Dockerfile
.dockerignore

# Python caches / virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Vectorizer weights — fetched at build time by the Dockerfile itself (always
# the same public checkpoint), never sent in the build context.
vectorizers/paraphrase-multilingual-mpnet-base-v2/model.safetensors
vectorizers/paraphrase-multilingual-mpnet-base-v2/config.json
vectorizers/paraphrase-multilingual-mpnet-base-v2/1_Pooling/

# promote.py's pre-overwrite weight backups - never read at runtime by
# ai_mail_classifier.py or inference_server/, just bloats the build context.
models_backup/

# models/ is NOT ignored: unlike the vectorizer there is no fixed public
# source for it — it's whatever train_models.ipynb / train_test_models.py
# produced, and the Dockerfile has no way to fetch it. It must be present in
# the build context (see AIMailAnalyzer.pdf's Setup section).

# Secrets / logs / OS cruft
*.env
*.log
.DS_Store

# Monthly retraining pipeline — operational tooling, not used by
# ai_mail_classifier.py at runtime. Also keeps locally-fetched training mail
# and IMAP credentials out of any built/pushed image.
retrain_model_monthly/
