# Copiez ce fichier en .env et renseignez les vrais identifiants.
# .env est gitignoré (règle *.env) - ne jamais committer de vrais identifiants.

# Boîte mail où les analystes filent les mails "challenged" une fois revus,
# un dossier IMAP par catégorie de Re_Train_Model/variable.py:folders
# (0_LEGIT_INTERNAL_COMMUNICATION, 0_LEGIT_EXTERNAL_COMMUNICATION, 1_SPAM,
# 1_NEWSLETTER, 2_CLASSIC_PHISHING, 2_WHALING_PHISHING, 2_CLONE_PHISHING,
# 2_BLACKMAILING_PHISHING). Ces dossiers doivent déjà exister côté serveur
# IMAP avec exactement ces noms (sensible à la casse), sinon generator_dataset.py
# les signale comme introuvables et les ignore silencieusement (pas d'échec dur).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# Optionnel - chemin vers le vectorizer pinné si différent du chemin par défaut
# (Analyzers/AIMailAnalyzer/vectorizers/paraphrase-multilingual-mpnet-base-v2)
# VECTORIZER_PATH=

# Optionnel - dossier où stocker le dataset.pkl cumulatif + l'état du dernier
# fetch IMAP (.fetch_state.json)
# DATASET_DIR=data_export

# Cadence des cycles de réentraînement en production, en minutes (utilisé par
# run_prod_retrain_cycle.sh, PAS par run_monthly_cycle.sh qui est dev-only).
# Pointez cron sur ce script souvent (ex: */5 * * * *) - il ne fait rien tant
# que ce nombre de minutes ne s'est pas écoulé depuis le dernier cycle
# terminé. Changez la cadence ici, pas besoin de "crontab -e".
# RETRAIN_INTERVAL_MINUTES=60

# Mois de départ (YYYY-MM) du rejeu historique pré-prod - utilisé par
# generator_dataset_month_replay.py/run_month_replay_cycle.sh uniquement.
# MONTH_REPLAY_START=2025-08
