# Optional: override API base for non-proxy environments.
# If you keep Nginx same-origin proxy (/api -> backend), you can leave this unset.
VITE_API_BASE=/api
VITE_FAVICON=/icons/suspicious-logo.png
VITE_COMPANY_NAME=Suspicious
VITE_COMPANY_LINK=https://test-suspicious.com
VITE_COMPANY_LOGO_BASE64=
VITE_COMPANY_LOGO_URL=/brand/logo.svg

VITE_SUSPICIOUS_EMAIL=suspicious@test-suspicious.com
VITE_GITHUB_REPO_URL=https://github.com/thalesgroup-cert/suspicious
VITE_DOCS_URL=https://<your-docs>
VITE_CHANGELOG_URL=https://<your-changelog>