{
  "name": "suspicious-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "bones": "boneyard-js build",
    "bones:watch": "boneyard-js build --watch",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "demo:record": "playwright test -c playwright.demo.config.ts demo/suspicious.demo",
    "demo:build": "bash demo/build.sh",
    "demo": "pnpm demo:record && pnpm demo:build",
    "demo:gifs:record": "playwright test -c playwright.demo.config.ts demo/pages.demo",
    "demo:gifs:build": "bash demo/build-gifs.sh",
    "demo:gifs": "pnpm demo:gifs:record && pnpm demo:gifs:build"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "framer-motion": "12.42.2",
    "notistack": "3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.2",
    "react-grid-layout": "2.2.3",
    "react-hook-form": "7.88.0",
    "react-joyride": "^3.2.0",
    "react-resizable": "4.0.2",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "three": "0.186.1",
    "zod": "4.6.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "boneyard-js": "1.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  }
}
