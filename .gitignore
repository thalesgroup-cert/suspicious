# ===== Logs =====
*.log
*.log.*
*.log-*
mainlog

# ===== Secrets / environment =====
# Runtime config holds secrets; never commit
*.env
db_suspicious.env
config.json
settings.json
# Vault unseal keys (host-only secret; never commit)
deployment/vault/unseal.keys

# ===== Certificates / keys =====
*.crt
*.csr
*.key
*.pem
*.jks
*.srl
.pnpm-store
# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.sqlite
*.sqlite3

# ===== Node / frontend =====
node_modules
suspicious-ui/.pnpm-store/
suspicious-ui/dist
suspicious-ui/.playwright
suspicious-ui/tsconfig.tsbuildinfo
# pnpm is the package manager (see package.json "packageManager"). Commit
# pnpm-lock.yaml for reproducible installs; never the npm lockfile.
suspicious-ui/package-lock.json
# Boneyard pixel-exact skeleton snapshots — regenerated by `npm run bones`
# (or boneyardPlugin on Vite dev). Only the registry.ts entry-point is checked in.
suspicious-ui/src/bones/*.bones.json
# Brand assets are deployment-specific (dropped in at runtime)
suspicious-ui/public/brand/*.svg

# ===== Service data / runtime volumes =====
chromadb
elasticsearch
cortex
minio
db_suspicious/data
backup
backups
*.old

# ===== ML models / weights (large, fetched at build/runtime) =====
Analyzers/AIMailAnalyzer/models
Analyzers/AIMailAnalyzer/models_backup
Analyzers/AIMailAnalyzer/vectorizers/paraphrase-multilingual-mpnet-base-v2/model.safetensors
Analyzers/AIMailAnalyzer/vectorizers/paraphrase-multilingual-mpnet-base-v2/config.json
Analyzers/AIMailAnalyzer/vectorizers/paraphrase-multilingual-mpnet-base-v2/1_Pooling

# ===== Monthly retrain pipeline: fetched mail + run outputs, never commit =====
Analyzers/AIMailAnalyzer/retrain model monthly/data_export/
Analyzers/AIMailAnalyzer/retrain model monthly/data_base_results/
Analyzers/AIMailAnalyzer/retrain model monthly/*_results/
Analyzers/AIMailAnalyzer/retrain model monthly/wandb/
Analyzers/AIMailAnalyzer/retrain model monthly/label_count_history.json
# golden_set.json pins content hashes from THIS deployment's own fetched
# mail (dataset.pkl, also gitignored above) - not portable across installs.
Analyzers/AIMailAnalyzer/retrain model monthly/golden_set.json
# promote.py's intermediate output dir before weights get copied up to the
# real Analyzers/AIMailAnalyzer/models/ (already ignored above) - binary
# .pth files, never commit.
Analyzers/AIMailAnalyzer/retrain model monthly/models/

