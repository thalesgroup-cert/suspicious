<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>{{ subject | default("Challenge Received") }}</title>
  <!--[if mso]>
  <noscript><xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml></noscript>
  <![endif]-->
  <style>
    body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
    table{border-collapse:collapse!important;mso-table-lspace:0pt;mso-table-rspace:0pt;}
    img{border:0;height:auto;line-height:100%;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}
    a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}

    @media screen and (max-width:620px){
      .email-container { width:100%!important; border-radius:0!important; }
      .content-pad     { padding:24px 18px!important; }
      .footer-pad      { padding:20px 18px!important; }
      .two-col td      { display:block!important; width:100%!important; text-align:left!important; padding-bottom:10px; }
    }
  </style>
</head>

{# =========================================================================
   Context from ChallengeToTheHiveService._context():
     subject  recipient_name  company  global_team  logos  urls  inquiry_text
     socials[].name  .url  .logo_svg  .logo_png
     challenger.firstname  .lastname  .email  .groups
     case.id  .score  .confidence  .result  .result_color
     case.ai.category  .ai.result  .ai.score  .ai.confidence
     case.artifacts[].label  .score  .confidence
     case.attachments[]
     mail.subject  mail.from
   ========================================================================= #}

<body style="margin:0;padding:0;word-break:break-word;
             -webkit-font-smoothing:antialiased;background-color:#EDF1F4;">

{# Preheader #}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;
            font-size:1px;line-height:1px;color:#EDF1F4;">
  {{ challenger.firstname }} {{ challenger.lastname }} has challenged the result of case #{{ case.id }}.
  &#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;
</div>

<!--[if mso | IE]>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
       style="background-color:#EDF1F4;"><tr><td align="center">
<![endif]-->

<table role="presentation" border="0" cellpadding="0" cellspacing="0"
       width="100%" style="background-color:#EDF1F4;">
<tr><td align="center" style="padding:32px 16px;">

<table class="email-container"
       role="article" aria-label="Security challenge notification"
       border="0" cellpadding="0" cellspacing="0"
       width="600"
       style="max-width:600px;width:100%;border-radius:14px;overflow:hidden;
              border:1px solid #D1D9E0;">


  {# ══════════════════════════════════════════════════════════════════════
     1 · HEADER
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td align="center" style="background-color:#242A75;padding:28px 40px;">
      {% if logos.company %}
        <!--[if !mso]><!-->
        <img src="{{ logos.company }}" alt="{{ company | default('') }}"
             width="130"
             style="max-width:130px;height:auto;display:block;margin:0 auto;">
        <!--<![endif]-->
        <!--[if mso]>
        <span style="font-size:20px;font-weight:800;letter-spacing:-0.5px;
                     color:#FFFFFF;font-family:Arial,sans-serif;">
          {{ company | default("Security Portal") }}
        </span>
        <![endif]-->
      {% else %}
        <span style="font-size:22px;font-weight:800;letter-spacing:-0.5px;color:#FFFFFF;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
          {{ company | default("Security Portal") }}
        </span>
      {% endif %}
    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     2 · VERDICT STRIP — result pill + case reference
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td style="background-color:#FFFFFF;padding:28px 40px 0;text-align:center;">

      <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center">
        <tr>
          <td style="background-color:{{ case.result_color }};border-radius:999px;
                     padding:7px 26px;font-size:11px;font-weight:800;
                     letter-spacing:0.12em;text-transform:uppercase;color:#FFFFFF;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.result }}
          </td>
        </tr>
      </table>

      <p style="margin:10px 0 0;font-size:12px;color:#64748B;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        Case&nbsp;#{{ case.id }} &mdash; challenged by
        <strong style="color:#1E293B;">{{ challenger.firstname }} {{ challenger.lastname }}</strong>
      </p>

    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     3 · BODY
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td class="content-pad"
        style="background-color:#FFFFFF;padding:24px 40px 36px;">

      {# Greeting #}
      <p style="margin:0 0 20px;font-size:20px;font-weight:800;
                letter-spacing:-0.3px;color:#00BBDD;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        Dear {{ recipient_name | default("Security Team") }},
      </p>

      <p style="margin:0 0 6px;font-size:15px;line-height:1.7;color:#334155;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        <strong style="color:#1E293B;">{{ challenger.firstname }} {{ challenger.lastname }}</strong>
        (<a href="mailto:{{ challenger.email }}"
            style="color:#00BBDD;text-decoration:none;">{{ challenger.email }}</a>)
        from group <strong style="color:#1E293B;">{{ challenger.groups }}</strong>
        has challenged the result of <strong style="color:#1E293B;">case #{{ case.id }}</strong>.
      </p>

      {# Hairline #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="margin:20px 0;">
        <tr><td style="border-top:1px solid #E2E8F0;font-size:0;padding:0;">&nbsp;</td></tr>
      </table>


      {# ── Mail + case details card ──────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="border:1px solid #E2E8F0;border-radius:10px;overflow:hidden;margin-bottom:22px;">

        <tr>
          <td colspan="2"
              style="background-color:#F1F5F9;padding:9px 16px;
                     color:#475569;font-size:11px;font-weight:700;
                     letter-spacing:0.08em;text-transform:uppercase;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Submission details
          </td>
        </tr>

        <tr>
          <td width="130"
              style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Mail subject
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:13px;color:#1E293B;word-break:break-all;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ mail.subject | default("—") }}
          </td>
        </tr>

        <tr>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            From
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:13px;color:#1E293B;word-break:break-all;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ mail.from | default("—") }}
          </td>
        </tr>

        <tr>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Case score
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:13px;color:#1E293B;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.score | default("—") }}
          </td>
        </tr>

        <tr>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Confidence
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:13px;color:#1E293B;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.confidence | default("—") }}
          </td>
        </tr>

        <tr>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            AI suggestion
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid #E2E8F0;
                     font-size:13px;color:#1E293B;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.ai.category }} / {{ case.ai.result }}
            <span style="color:#64748B;">(Score {{ case.ai.score }}, Confidence {{ case.ai.confidence }})</span>
          </td>
        </tr>

        <tr>
          <td style="padding:10px 16px;
                     font-size:12px;font-weight:700;color:#64748B;
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Result
          </td>
          <td style="padding:10px 16px;
                     font-size:13px;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            <strong style="color:{{ case.result_color }};">{{ case.result }}</strong>
          </td>
        </tr>

      </table>


      {# ── Artifacts card ────────────────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="border:1px solid #E2E8F0;border-radius:10px;overflow:hidden;margin-bottom:22px;">

        <tr>
          <td colspan="3"
              style="background-color:#F1F5F9;padding:9px 16px;
                     color:#475569;font-size:11px;font-weight:700;
                     letter-spacing:0.08em;text-transform:uppercase;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Extracted artifacts
          </td>
        </tr>

        {% if case.artifacts %}
          {# Header row #}
          <tr>
            <td style="padding:8px 16px;border-bottom:1px solid #E2E8F0;
                       font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;
                       letter-spacing:0.06em;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              Type
            </td>
            <td style="padding:8px 16px;border-bottom:1px solid #E2E8F0;
                       font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;
                       letter-spacing:0.06em;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              Score
            </td>
            <td style="padding:8px 16px;border-bottom:1px solid #E2E8F0;
                       font-size:11px;font-weight:700;color:#64748B;text-transform:uppercase;
                       letter-spacing:0.06em;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              Confidence
            </td>
          </tr>
          {% for a in case.artifacts %}
          <tr>
            <td style="padding:9px 16px;
                       {% if not loop.last %}border-bottom:1px solid #E2E8F0;{% endif %}
                       font-size:13px;color:#1E293B;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ a.label }}
            </td>
            <td style="padding:9px 16px;
                       {% if not loop.last %}border-bottom:1px solid #E2E8F0;{% endif %}
                       font-size:13px;color:#1E293B;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ a.score }}
            </td>
            <td style="padding:9px 16px;
                       {% if not loop.last %}border-bottom:1px solid #E2E8F0;{% endif %}
                       font-size:13px;color:#1E293B;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ a.confidence }}
            </td>
          </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="3"
                style="padding:12px 16px;font-size:13px;color:#64748B;font-style:italic;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              No artifacts found.
            </td>
          </tr>
        {% endif %}

      </table>


      {# ── Attachments card ──────────────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="border:1px solid #E2E8F0;border-radius:10px;overflow:hidden;margin-bottom:24px;">

        <tr>
          <td style="background-color:#F1F5F9;padding:9px 16px;
                     color:#475569;font-size:11px;font-weight:700;
                     letter-spacing:0.08em;text-transform:uppercase;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Attachments
          </td>
        </tr>

        {% if case.attachments %}
          {% for att in case.attachments %}
          <tr>
            <td style="padding:9px 16px;
                       {% if not loop.last %}border-bottom:1px solid #E2E8F0;{% endif %}
                       font-size:13px;color:#1E293B;word-break:break-all;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ att }}
            </td>
          </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td style="padding:12px 16px;font-size:13px;color:#64748B;font-style:italic;
                       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              No attachments.
            </td>
          </tr>
        {% endif %}

      </table>


      {# ── CTA ───────────────────────────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="margin-bottom:22px;">
        <tr>
          <td align="center">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                         xmlns:w="urn:schemas-microsoft-com:office:word"
                         href="{{ urls.portal | default('#') }}"
                         style="height:44px;v-text-anchor:middle;width:240px;"
                         arcsize="18%" strokecolor="#00BBDD" fillcolor="#00BBDD">
              <w:anchorlock/>
              <center style="color:#FFFFFF;font-family:Arial,sans-serif;
                             font-size:14px;font-weight:bold;">
                Review case on portal
              </center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-->
            <a href="{{ urls.portal | default('#') }}"
               target="_blank" rel="noopener noreferrer"
               style="display:inline-block;background-color:#00BBDD;
                      color:#FFFFFF;padding:13px 32px;border-radius:8px;
                      font-size:14px;font-weight:700;text-decoration:none;
                      letter-spacing:0.2px;mso-hide:all;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              Review case on portal
            </a>
            <!--<![endif]-->
          </td>
        </tr>
      </table>

      <p style="margin:0;font-size:13px;line-height:1.6;color:#334155;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        {{ company | default("") }} Team
      </p>

    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     4 · FOOTER LINKS
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td class="footer-pad"
        style="background-color:#242A75;padding:22px 40px;">
      <table class="two-col" role="presentation"
             border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="vertical-align:top;padding-right:16px;">
            <p style="margin:0 0 6px;">
              <a href="{{ urls.glossary | default('#') }}"
                 style="color:#93C5FD;text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Cybersecurity glossary
              </a>
            </p>
            <p style="margin:0 0 6px;">
              <a href="{{ urls.portal | default('#') }}"
                 style="color:#93C5FD;text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Submission portal
              </a>
            </p>
            {% if urls.inquiry %}
            <p style="margin:0;">
              <a href="{{ urls.inquiry }}"
                 style="color:#93C5FD;text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                {{ inquiry_text | default("Contact us") }}
              </a>
            </p>
            {% endif %}
          </td>
          <td style="vertical-align:top;text-align:right;">
            <p style="margin:0 0 4px;font-size:14px;font-weight:800;color:#FFFFFF;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ company | default("Company") }}
            </p>
            {% if urls.global %}
            <p style="margin:0;">
              <a href="{{ urls.global }}"
                 style="color:#93C5FD;text-decoration:none;font-size:12px;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                {{ global_team | default("") }}
              </a>
            </p>
            {% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     5 · SOCIAL ICONS
  ══════════════════════════════════════════════════════════════════════ #}
  {% if socials %}
  <tr>
    <td align="center"
        style="background-color:#242A75;padding:12px 40px 20px;
               border-top:1px solid #3B4499;">
      {% for s in socials %}
      <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer"
         style="display:inline-block;margin:0 5px;">
        <!--[if mso]>
        <img src="{{ s.logo_png }}" alt="{{ s.name }}" width="20" height="20"
             style="display:inline-block;vertical-align:middle;">
        <![endif]-->
        <!--[if !mso]><!-->
        <img src="{{ s.logo_svg }}" alt="{{ s.name }}" width="20" height="20"
             style="display:inline-block;vertical-align:middle;opacity:0.88;">
        <!--<![endif]-->
      </a>
      {% endfor %}
    </td>
  </tr>
  {% endif %}


  {# ══════════════════════════════════════════════════════════════════════
     6 · LEGAL STRIP
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td align="center"
        style="background-color:#EDF1F4;padding:16px 40px;
               border-top:1px solid #D1D9E0;
               color:#64748B;font-size:11px;line-height:1.6;
               font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
      This message was sent automatically by
      <strong>{{ company | default("the security platform") }}</strong>.
      Please do not reply directly to this email.
    </td>
  </tr>

</table>

</td></tr>
</table>

<!--[if mso | IE]>
</td></tr></table>
<![endif]-->

</body>
</html>