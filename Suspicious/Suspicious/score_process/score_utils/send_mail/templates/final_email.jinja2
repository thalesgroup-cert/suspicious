<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <title>{{ subject | default("Analysis Complete") }}</title>
  <!--[if mso]>
  <noscript><xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml></noscript>
  <![endif]-->
  <style>
    body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}
    table{border-collapse:collapse!important;mso-table-lspace:0pt;mso-table-rspace:0pt;}
    img{border:0;height:auto;line-height:100%;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;}
    a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}

    @media screen and (max-width:620px){
      .email-container  { width:100%!important; border-radius:0!important; }
      .content-pad      { padding:24px 18px!important; }
      .footer-pad       { padding:20px 18px!important; }
      .two-col td       { display:block!important; width:100%!important; text-align:left!important; padding-bottom:10px; }
      .score-cell       { display:block!important; width:100%!important; text-align:center!important; padding:6px 0!important; }
      .verdict-cards td { display:block!important; width:100%!important; padding-bottom:8px!important; }
    }
  </style>
</head>

{# =========================================================================
   Theme variables injected via **resolve_email_theme(profile):
     bg  surface  header_bg  header_text  accent  accent_text
     body_text  muted  border  link  cta_bg  cta_text
     color_safe  color_suspicious  color_dangerous  color_inconclusive
     color_done  color_in_progress  color_new  color_failure  color_challenged

   Case context from FinalEmailService._build_case_context():
     case.type         case.subject      case.sender     case.recipient
     case.result       case.result_label case.result_color (resolved hex)
     case.result_guidance
     case.result_ai    case.category_ai
     case.score        case.confidence   case.challenge_url
   ========================================================================= #}

<body style="margin:0;padding:0;word-break:break-word;
             -webkit-font-smoothing:antialiased;background-color:{{ bg }};">

{# Preheader — inbox snippet #}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;
            font-size:1px;line-height:1px;color:{{ bg }};">
  Analysis complete: {{ case.result_label }}. Open to see the full verdict and recommended actions.
  &#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;&#847;&zwj;
</div>

<!--[if mso | IE]>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
       style="background-color:{{ bg }};"><tr><td align="center">
<![endif]-->

<table role="presentation" border="0" cellpadding="0" cellspacing="0"
       width="100%" style="background-color:{{ bg }};">
<tr><td align="center" style="padding:32px 16px;">

<table class="email-container"
       role="article" aria-label="Security analysis result"
       border="0" cellpadding="0" cellspacing="0"
       width="600"
       style="max-width:600px;width:100%;border-radius:14px;overflow:hidden;
              border:1px solid {{ border }};">


  {# ══════════════════════════════════════════════════════════════════════
     1 · HEADER — logo / wordmark
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td align="center"
        style="background-color:{{ header_bg }};padding:26px 40px;">
      {% if company_logo %}
        <img src="{{ company_logo }}" alt="{{ company_name | default('') }}"
             width="130"
             style="max-width:130px;height:auto;display:block;margin:0 auto;">
      {% else %}
        <span style="font-size:22px;font-weight:800;letter-spacing:-0.5px;
                     color:{{ header_text }};
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
          {{ company_name | default("Security Portal") }}
        </span>
      {% endif %}
    </td>
  </tr>

  {# ══════════════════════════════════════════════════════════════════════
     2 · HERO — banner or verdict-coloured gradient rule
     The rule colour changes per result so the email "feels" like the verdict
  ══════════════════════════════════════════════════════════════════════ #}
  {% if final_logo %}
  <tr>
    <td style="background-color:{{ header_bg }};padding:0;line-height:0;font-size:0;
               border-bottom:4px solid {{ case.result_color }};">
      <img src="{{ final_logo }}" alt="" role="presentation" width="600"
           style="width:100%;max-width:600px;height:auto;display:block;">
    </td>
  </tr>
  {% else %}
  <tr>
    <td style="padding:0;font-size:0;line-height:0;height:5px;
               background:linear-gradient(90deg,{{ case.result_color }} 0%,{{ muted }} 100%);">
      <!--[if mso]>&nbsp;<![endif]-->
    </td>
  </tr>
  {% endif %}


  {# ══════════════════════════════════════════════════════════════════════
     3 · VERDICT HERO — pill + score numerals
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td style="background-color:{{ surface }};padding:32px 40px 0;text-align:center;">

      {# Verdict pill #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center">
        <tr>
          <td style="background-color:{{ case.result_color }};
                     border-radius:999px;padding:7px 26px;
                     font-size:11px;font-weight:800;letter-spacing:0.12em;
                     text-transform:uppercase;color:{{ surface }};
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.result_label }}
          </td>
        </tr>
      </table>

      {# Score + confidence + AI result — three equal numerals in a strip #}
      {% if case.score is not none or case.confidence is not none or case.result_ai %}
      {# Thin separator above the metric strip #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0"
             width="100%" style="margin-top:20px;">
        <tr>
          <td style="border-top:1px solid {{ border }};font-size:0;padding:0;">&nbsp;</td>
        </tr>
      </table>

      <table role="presentation" border="0" cellpadding="0" cellspacing="0"
             width="100%" style="margin:0;">
        <tr>

          {# RISK SCORE #}
          {% if case.score is not none %}
          <td class="score-cell"
              style="width:33%;padding:16px 8px;text-align:center;vertical-align:middle;
                     border-right:1px solid {{ border }};
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            <span style="font-size:34px;font-weight:900;line-height:1;
                         color:{{ case.result_color }};">
              {{ "%.1f"|format(case.score) }}
            </span>
            <span style="font-size:11px;font-weight:700;color:{{ muted }};
                         display:block;margin-top:5px;text-transform:uppercase;
                         letter-spacing:0.06em;">
              Risk score&nbsp;/&nbsp;10
            </span>
          </td>
          {% endif %}

          {# CONFIDENCE #}
          {% if case.confidence is not none %}
          <td class="score-cell"
              style="width:33%;padding:16px 8px;text-align:center;vertical-align:middle;
                     {% if case.result_ai %}border-right:1px solid {{ border }};{% endif %}
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            <span style="font-size:34px;font-weight:900;line-height:1;
                         color:{{ accent }};">
              {{ "%.0f"|format(case.confidence) }}%
            </span>
            <span style="font-size:11px;font-weight:700;color:{{ muted }};
                         display:block;margin-top:5px;text-transform:uppercase;
                         letter-spacing:0.06em;">
              Confidence
            </span>
          </td>
          {% endif %}

          {# AI VERDICT — same visual weight as the numeric metrics #}
          {% if case.result_ai %}
          <td class="score-cell"
              style="width:34%;padding:16px 8px;text-align:center;vertical-align:middle;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {# AI verdict pill — same style as the main verdict pill but smaller #}
            <div>
              <!--[if mso]>
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center">
              <tr><td style="background-color:{{ muted }};border-radius:4px;
                             padding:4px 12px;font-size:11px;font-weight:700;
                             color:{{ surface }};font-family:Arial,sans-serif;">
                {{ case.result_ai }}
              </td></tr></table>
              <![endif]-->
              <!--[if !mso]><!-->
              <span style="display:inline-block;background-color:{{ muted }};
                           border-radius:4px;padding:4px 12px;
                           font-size:11px;font-weight:800;letter-spacing:0.06em;
                           text-transform:uppercase;color:{{ surface }};
                           mso-hide:all;">
                {{ case.result_ai }}
              </span>
              <!--<![endif]-->
            </div>
            {% if case.category_ai %}
            <span style="font-size:12px;font-weight:700;color:{{ body_text }};
                         display:block;margin-top:6px;">
              {{ case.category_ai }}
            </span>
            {% endif %}
            <span style="font-size:11px;font-weight:700;color:{{ muted }};
                         display:block;margin-top:5px;text-transform:uppercase;
                         letter-spacing:0.06em;">
              AI assessment
            </span>
          </td>
          {% endif %}

        </tr>
      </table>

      {# Bottom separator #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="border-top:1px solid {{ border }};font-size:0;padding:0;">&nbsp;</td>
        </tr>
      </table>
      {% endif %}

    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     4 · BODY
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td class="content-pad"
        style="background-color:{{ surface }};padding:28px 40px 36px;">

      {# Greeting #}
      <p style="margin:0 0 18px;font-size:20px;font-weight:800;
                letter-spacing:-0.3px;color:{{ accent }};
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        Dear {{ recipient_name | default("Security Contributor") }},
      </p>

      <p style="margin:0 0 24px;font-size:14px;line-height:1.7;color:{{ body_text }};
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        The analysis of your submission has been completed by
        {% if company_name %}<strong style="color:{{ body_text }};">{{ company_name }}</strong>{% else %}our security team{% endif %}.
        Here is a summary of what was found and what you should do next.
      </p>

      {# ── Hairline ────────────────────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr><td style="border-top:1px solid {{ border }};font-size:0;padding:0;">&nbsp;</td></tr>
      </table>


      {# ── Submission details card ─────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="margin:22px 0 0;border:1px solid {{ border }};
                    border-radius:10px;overflow:hidden;">

        <tr>
          <td colspan="2"
              style="background-color:{{ header_bg }};padding:9px 16px;
                     color:{{ header_text }};font-size:11px;font-weight:700;
                     letter-spacing:0.08em;text-transform:uppercase;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Submission details
          </td>
        </tr>

        {# Type #}
        <tr>
          <td width="110"
              style="padding:10px 16px;border-bottom:1px solid {{ border }};
                     font-size:12px;font-weight:700;color:{{ muted }};
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Type
          </td>
          <td style="padding:10px 16px;border-bottom:1px solid {{ border }};
                     font-size:13px;color:{{ body_text }};
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.type | default("—") }}
          </td>
        </tr>

        {# Subject / artifact #}
        <tr>
          <td style="padding:10px 16px;
                     {% if case.sender or case.recipient %}border-bottom:1px solid {{ border }};{% endif %}
                     font-size:12px;font-weight:700;color:{{ muted }};
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ "Subject" if case.type == "Email" else "Artifact" }}
          </td>
          <td style="padding:10px 16px;
                     {% if case.sender or case.recipient %}border-bottom:1px solid {{ border }};{% endif %}
                     font-size:13px;color:{{ body_text }};word-break:break-all;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.subject | default("—") }}
          </td>
        </tr>

        {% if case.sender %}
        <tr>
          <td style="padding:10px 16px;
                     {% if case.recipient %}border-bottom:1px solid {{ border }};{% endif %}
                     font-size:12px;font-weight:700;color:{{ muted }};
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Sender
          </td>
          <td style="padding:10px 16px;
                     {% if case.recipient %}border-bottom:1px solid {{ border }};{% endif %}
                     font-size:13px;color:{{ body_text }};word-break:break-all;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.sender }}
          </td>
        </tr>
        {% endif %}

        {% if case.recipient %}
        <tr>
          <td style="padding:10px 16px;font-size:12px;font-weight:700;color:{{ muted }};
                     vertical-align:top;white-space:nowrap;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            Recipient
          </td>
          <td style="padding:10px 16px;font-size:13px;color:{{ body_text }};word-break:break-all;
                     font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
            {{ case.recipient }}
          </td>
        </tr>
        {% endif %}

      </table>
      {# / submission details #}


      {# ══════════════════════════════════════════════════════════════
         VERDICT CARD — mirrors the about-page classification cards
         Icon circle + coloured title + bullet list
      ══════════════════════════════════════════════════════════════ #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="margin:20px 0 0;border:1px solid {{ case.result_color }};
                    border-radius:10px;overflow:hidden;">
        <tr>
          {# Left colour accent bar — same 6 px trick as the legend rows #}
          <td width="5"
              style="background-color:{{ case.result_color }};
                     width:5px;padding:0;font-size:0;line-height:0;">&nbsp;</td>
          <td style="padding:18px 20px;background-color:{{ surface }};">

            {# Icon + title row #}
            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
              <tr>
                {# Icon circle #}
                <td width="36" style="vertical-align:middle;padding-right:12px;">
                  <div style="width:36px;height:36px;border-radius:50%;
                              background-color:{{ case.result_color }}1A;
                              border:1.5px solid {{ case.result_color }};
                              text-align:center;line-height:36px;font-size:17px;">
                    {# Unicode icon per verdict type — renders in all major clients #}
                    {% if case.result == "Dangerous" %}
                      <span style="color:{{ case.result_color }};">&#9888;</span>
                    {% elif case.result == "Suspicious" %}
                      <span style="color:{{ case.result_color }};">&#9650;</span>
                    {% elif case.result == "Safe" or case.result == "AllowListed" %}
                      <span style="color:{{ case.result_color }};">&#10003;</span>
                    {% elif case.result == "Failure" %}
                      <span style="color:{{ case.result_color }};">&#10005;</span>
                    {% else %}
                      <span style="color:{{ case.result_color }};">&#63;</span>
                    {% endif %}
                  </div>
                </td>
                {# Title + subtitle #}
                <td style="vertical-align:middle;">
                  <span style="font-size:16px;font-weight:800;color:{{ case.result_color }};
                               font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                    {{ case.result_label }}
                  </span>
                  <span style="display:block;font-size:12px;color:{{ muted }};margin-top:2px;
                               font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                    {{ case.result_guidance | truncate(60, true, '…') }}
                  </span>
                </td>
              </tr>
            </table>

            {# Divider #}
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
                   style="margin:14px 0 12px;">
              <tr>
                <td style="border-top:1px solid {{ border }};font-size:0;padding:0;">&nbsp;</td>
              </tr>
            </table>

            {# Guidance full text #}
            <p style="margin:0 0 12px;font-size:13px;line-height:1.65;color:{{ body_text }};
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ case.result_guidance }}
            </p>

            {# Recommended actions — bullet list per verdict
               These are static copy that matches the about-page cards #}
            {% if case.result == "Dangerous" %}
              {% set bullets = [
                "Do not open or execute any files or links.",
                "Treat all content from this sender as untrusted.",
                "Escalate or isolate immediately if already opened."
              ] %}
            {% elif case.result == "Suspicious" %}
              {% set bullets = [
                "Avoid opening links or attachments.",
                "Prefer validation by a security analyst before acting.",
                "Monitor related activity for further indicators."
              ] %}
            {% elif case.result == "Inconclusive" or case.result == "Unchallenged" %}
              {% set bullets = [
                "Proceed with caution — verdict could not be confirmed.",
                "Source trust may be unclear.",
                "Request more context or re-submit if behaviour changes."
              ] %}
            {% elif case.result == "Safe" or case.result == "AllowListed" %}
              {% set bullets = [
                "No strong indicators of malice were found.",
                "Still apply normal security hygiene.",
                "Re-submit if the item's behaviour changes."
              ] %}
            {% elif case.result == "Failure" %}
              {% set bullets = [
                "The analysis pipeline encountered an error.",
                "Our team has been notified and will review manually.",
                "You may re-submit the item if the issue persists."
              ] %}
            {% else %}
              {% set bullets = [
                "Review the case details on the portal.",
                "Contact the security team if you have concerns."
              ] %}
            {% endif %}

            {% for bullet in bullets %}
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
                   style="margin-bottom:6px;">
              <tr>
                <td width="18" style="vertical-align:top;padding-top:1px;">
                  <span style="display:inline-block;width:6px;height:6px;
                               border-radius:50%;background-color:{{ case.result_color }};
                               margin-top:5px;">&nbsp;</span>
                </td>
                <td style="font-size:13px;line-height:1.6;color:{{ body_text }};
                           font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                  {{ bullet }}
                </td>
              </tr>
            </table>
            {% endfor %}

          </td>
        </tr>
      </table>
      {# / verdict card #}



      {# ── CTA buttons ────────────────────────────────────────────── #}
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
             style="margin-top:24px;margin-bottom:22px;">
        <tr>
          {# Primary — view case #}
          <td align="center" style="padding-right:{% if case.challenge_url %}8px{% else %}0{% endif %};">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                         xmlns:w="urn:schemas-microsoft-com:office:word"
                         href="{{ portal_url | default('#') }}"
                         style="height:44px;v-text-anchor:middle;width:{% if case.challenge_url %}210px{% else %}260px{% endif %};"
                         arcsize="18%" strokecolor="{{ cta_bg }}" fillcolor="{{ cta_bg }}">
              <w:anchorlock/>
              <center style="color:{{ cta_text }};font-family:Arial,sans-serif;
                             font-size:13px;font-weight:bold;">
                View case details
              </center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-->
            <a href="{{ portal_url | default('#') }}"
               target="_blank" rel="noopener noreferrer"
               style="display:inline-block;background-color:{{ cta_bg }};
                      color:{{ cta_text }};padding:13px 28px;border-radius:8px;
                      font-size:13px;font-weight:700;text-decoration:none;
                      letter-spacing:0.2px;mso-hide:all;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              View case details
            </a>
            <!--<![endif]-->
          </td>

          {# Secondary — challenge (conditional) #}
          {% if case.challenge_url %}
          <td align="center" style="padding-left:8px;">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                         xmlns:w="urn:schemas-microsoft-com:office:word"
                         href="{{ case.challenge_url }}"
                         style="height:44px;v-text-anchor:middle;width:210px;"
                         arcsize="18%" strokecolor="{{ border }}" fillcolor="{{ surface }}">
              <w:anchorlock/>
              <center style="color:{{ body_text }};font-family:Arial,sans-serif;
                             font-size:13px;font-weight:bold;">
                Challenge result
              </center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-->
            <a href="{{ case.challenge_url }}"
               target="_blank" rel="noopener noreferrer"
               style="display:inline-block;background-color:{{ surface }};
                      color:{{ body_text }};padding:13px 28px;border-radius:8px;
                      font-size:13px;font-weight:700;text-decoration:none;
                      border:1px solid {{ border }};mso-hide:all;
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              Challenge result
            </a>
            <!--<![endif]-->
          </td>
          {% endif %}
        </tr>
      </table>

      {# Footnote #}
      <p style="margin:0;font-size:12px;line-height:1.6;
                color:{{ muted }};font-style:italic;
                font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
        * AI classifications are indicative. The final verdict is determined by
        our security analysts and automated scoring pipeline.
      </p>

    </td>
  </tr>
  {# / body #}

  {# ══════════════════════════════════════════════════════════════════════
     6 · FOOTER LINKS
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td class="footer-pad"
        style="background-color:{{ header_bg }};padding:20px 40px;
               border-top:1px solid {{ border }};">
      <table class="two-col" role="presentation"
             border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="vertical-align:top;padding-right:16px;">
            <p style="margin:0 0 6px;">
              <a href="{{ glossary_url | default('#') }}"
                 style="color:{{ footer_text }};text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Cybersecurity glossary
              </a>
            </p>
            <p style="margin:0 0 6px;">
              <a href="{{ portal_url | default('#') }}"
                 style="color:{{ footer_text }};text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Submission portal
              </a>
            </p>
            {% if inquiry_url %}
            <p style="margin:0;">
              <a href="{{ inquiry_url }}"
                 style="color:{{ footer_text }};text-decoration:none;font-size:13px;font-weight:600;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                {{ inquiry_text | default("Contact us") }}
              </a>
            </p>
            {% endif %}
          </td>
          <td style="vertical-align:top;text-align:right;">
            <p style="margin:0 0 5px;font-size:14px;font-weight:800;color:{{ header_text }};
                      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
              {{ company_name | default("Company") }}
            </p>
            {% if global_url %}
            <p style="margin:0;">
              <a href="{{ global_url }}"
                 style="color:{{ footer_text }};text-decoration:none;font-size:12px;
                        font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                {{ global_team | default("") }}
              </a>
            </p>
            {% endif %}
          </td>
        </tr>
      </table>
    </td>
  </tr>


  {# ══════════════════════════════════════════════════════════════════════
     7 · SOCIAL ICONS
  ══════════════════════════════════════════════════════════════════════ #}
  {% if socials %}
  <tr>
    <td align="center"
        style="background-color:{{ header_bg }};padding:12px 40px 20px;
               border-top:1px solid {{ border }};">
      {% for social in socials %}
      <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer"
         style="display:inline-block;margin:0 5px;">
        <img src="{{ social.logo }}" alt="{{ social.name }}"
             width="24" height="24"
             style="display:inline-block;vertical-align:middle;opacity:0.88;">
      </a>
      {% endfor %}
    </td>
  </tr>
  {% endif %}


  {# ══════════════════════════════════════════════════════════════════════
     8 · LEGAL STRIP
  ══════════════════════════════════════════════════════════════════════ #}
  <tr>
    <td align="center"
        style="background-color:{{ bg }};padding:16px 40px;
               border-top:1px solid {{ border }};
               color:{{ muted }};font-size:11px;line-height:1.6;
               font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
      This message was sent automatically by
      <strong>{{ company_name | default("the security platform") }}</strong>.
      Please do not reply directly to this email.
    </td>
  </tr>

</table>
{# / outer container #}

</td></tr>
</table>

<!--[if mso | IE]>
</td></tr></table>
<![endif]-->

</body>
</html>