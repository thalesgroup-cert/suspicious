# Meridian Group — dev/test directory seed for profiles/profiles_utils/ldap.py
# Loaded via `ldapadd` against the running openldap dev container (see deploy
# notes) rather than through the image's bootstrap-ldif volume, which chowns/
# sed's/rm's those paths in place and collides with bind mounts.
# Standard schema only (inetOrgPerson + extensibleObject) — title/businessCategory/c
# are all standard RFC4519 attributes, no custom schema needed.
#
# sam.whitfield deliberately carries businessCategory: Admin — this is the
# attacker/misconfiguration scenario finding #4 fixed: without the reserved-group
# guard in Ldap.add_user_to_group, syncing this entry would silently add Sam to
# the real Django "Admin" RBAC group.

dn: ou=people,dc=meridian,dc=example
objectClass: organizationalUnit
ou: people

dn: uid=elena.voss,ou=people,dc=meridian,dc=example
objectClass: inetOrgPerson
objectClass: extensibleObject
uid: elena.voss
cn: Elena Voss
sn: Voss
givenName: Elena
mail: elena.voss@meridian.example
title: CERT Team Lead
businessCategory: CERT
c: FR
userPassword: MeridianDev!2026

