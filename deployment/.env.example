# .env — Suspicious platform configuration example
#
# ⚠  NEVER commit .env file to version control.
# Add `.env` to your .gitignore.
#
# For CI/CD pipelines, inject these as masked environment variables
# in your pipeline (GitLab CI / GitHub Actions secrets) and write
# them to .env at deploy time — do not store them in the repo.
#
# Credentials marked [SECRET] must be rotated regularly and should
# ideally be managed by a secrets manager (Vault, AWS Secrets Manager,
# SOPS + age, etc.).

# =============================================================================
# IMAGE VERSIONS  — pin to specific digests in production for reproducibility
# =============================================================================

SUSPICIOUS_VERSION=latest
# UI + feeder default to SUSPICIOUS_VERSION when unset; pin independently if needed.
SUSPICIOUS_UI_VERSION=
SUSPICIOUS_FEEDER_VERSION=
DB_SUSPICIOUS_VERSION=11.4
RUSTFS_VERSION=1.0.0-alpha.90
CORTEX_VERSION=4.0.0-1
ELASTICSEARCH_VERSION=8.19.7
TRAEFIK_VERSION=v3.3.4
CHROMADB_VERSION=0.6.3
REDIS_BROKER_VERSION=9-alpine
REDIS_CACHE_VERSION=9-alpine


# =============================================================================
# DOMAIN & NETWORK
# =============================================================================

DOMAIN_CORP=your.corporate.domain
NETWORK_NAME=suspicious_net
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1
NETWORK_IP_RANGE=172.20.0.0/24

# =============================================================================
# EXPOSED PORTS  (all bound to 127.0.0.1 — only Traefik faces the internet)
# =============================================================================

SUSPICIOUS_PORT=9020
SUSPICIOUS_UI_PORT=9021
MINIO_PORT=35000          # MinIO console — local access only
CORTEX_PORT=9001
ELASTICSEARCH_PORT=9200   # not exposed externally in docker-compose.yml

# =============================================================================
# DATABASE  [SECRET]
# =============================================================================

MYSQL_DATABASE=db_suspicious
MYSQL_USER=suspicious
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_db_root_password

# Replication user — only required if you opt into the read replica (R6).
# Set before running `make db-replica-init`.
REPL_USER=replicator
REPL_PASSWORD=CHANGE_ME_replication_password

# InnoDB tuning — adjust to your host memory
INNODB_BUFFER_POOL_SIZE=2048M
INNODB_IO_CAPACITY=1000
INNODB_IO_CAPACITY_MAX=2000
INNODB_LOG_FILE_SIZE=600M
INNODB_READ_IO_THREADS=16
INNODB_WRITE_IO_THREADS=4
INNODB_CHANGE_BUFFERING=none
INNODB_STATS_PERSISTENT=ON

# =============================================================================
# ELASTICSEARCH
# =============================================================================

# Heap: set to ~50% of available RAM, max 31g (JVM compressed-oops limit).
ES_JAVA_OPTS="-Xms3g -Xmx3g"

# =============================================================================
# MINIO  [SECRET]
# =============================================================================

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# =============================================================================
# APPLICATION PATHS  (relative to the docker/ directory)
# =============================================================================

ROOT_PATH=../
SUSPICIOUS_PATH=../Suspicious
SUSPICIOUS_UI_PATH=../suspicious-ui
FEEDER_PATH=../email-feeder
DOCKER_PATH=../docker
YARA_PATH=../yara-rules
MISP_PATH=../misp
CORTEX_PATH=../cortex
AIANALYZER_PATH=../Analyzers/AIMailAnalyzer
CA_PATH=./certificates
TRAEFIK_PATH=../traefik

# =============================================================================
# CONTAINER NAMES
# =============================================================================

DB_CONTAINER=db_suspicious
WEB_CONTAINER=suspicious

# =============================================================================
# PROXIES  (leave blank if not behind a corporate proxy)
# =============================================================================

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost

# =============================================================================
# FRONTEND (SPA runtime config)
# The UI reads its VITE_* values from suspicious-ui/.env at container start
# (loaded as env_file, injected into window.__ENV__ — no rebuild needed).
# Copy suspicious-ui/.env.example -> suspicious-ui/.env and edit there.
# =============================================================================